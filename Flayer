<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tour Medellín Real</title>

<style>
body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
  color: #fff;
  background: url('https://images.unsplash.com/photo-1580674285054-bed31e145f59') no-repeat center/cover;
}

/* OVERLAY OSCURO */
.overlay {
  background: rgba(0,0,0,0.75);
  min-height: 100vh;
  padding: 30px;
}

/* ANIMACIÓN ENTRADA */
.flyer {
  max-width: 900px;
  margin: auto;
  background: rgba(20,20,20,0.9);
  padding: 30px;
  border-radius: 20px;
  animation: fadeIn 1.2s ease;
}

@keyframes fadeIn {
  from {opacity: 0; transform: translateY(30px);}
  to {opacity: 1; transform: translateY(0);}
}

/* TITULO */
.title {
  font-size: 38px;
  text-align: center;
  color: #f5c542;
}

/* GRID */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.card {
  background: #1a1a1a;
  padding: 15px;
  border-radius: 12px;
  transition: 0.3s;
}

/* HOVER */
.card:hover {
  transform: scale(1.05);
  box-shadow: 0 0 15px rgba(245,197,66,0.4);
}

/* VIDEO */
.video-card {
  margin-top: 20px;
  border-radius: 15px;
  overflow: hidden;
  position: relative;
}

.video-controls {
  position: absolute;
  bottom: 10px;
  left: 10px;
}

button {
  background: #f5c542;
  border: none;
  padding: 8px;
  margin-right: 5px;
  cursor: pointer;
}

/* GOOGLE MAPS */
.map {
  margin-top: 20px;
  border-radius: 15px;
  overflow: hidden;
}

/* QR */
.qr {
  text-align: center;
  margin-top: 20px;
}

.qr img {
  width: 120px;
}

/* BOTÓN FLOTANTE */
.float-btn {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #25D366;
  color: #fff;
  padding: 15px 20px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: bold;
  box-shadow: 0 0 15px rgba(0,0,0,0.5);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% {transform: scale(1);}
  50% {transform: scale(1.1);}
  100% {transform: scale(1);}
}

@media(max-width:600px){
  .grid {grid-template-columns: 1fr;}
}
</style>
</head>

<body>

<div class="overlay">

<div class="flyer">

  <div class="title">Tour Medellín Real</div>

  <div class="grid">
    <div class="card"><strong>Guía:</strong><br>Juan David Prince Ángel</div>
    <div class="card"><strong>Duración:</strong><br>2h 30min</div>
    <div class="card"><strong>Tipo:</strong><br>Caminata</div>
    <div class="card"><strong>Dificultad:</strong><br>Baja</div>
    <div class="card"><strong>Idioma:</strong><br>Esp / Eng</div>
    <div class="card"><strong>Hora:</strong><br>2:00 p.m.</div>
  </div>

  <!-- VIDEO -->
  <div class="video-card">
    <video id="videoTour" width="100%">
      <source src="video-tour.mp4" type="video/mp4">
    </video>

    <div class="video-controls">
      <button onclick="video.play()">▶</button>
      <button onclick="video.pause()">⏸</button>
      <button onclick="stopVideo()">✖</button>
    </div>
  </div>

  <!-- MAPA -->
  <div class="map">
    <iframe 
      src="https://www.google.com/maps?q=Plaza+Botero+Medellin&output=embed"
      width="100%" height="250" style="border:0;">
    </iframe>
  </div>

  <!-- QR -->
  <div class="qr">
    <p>Escanea para reservar</p>
    <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://wa.me/573247615677">
  </div>

</div>

</div>

<!-- BOTÓN FLOTANTE -->
<a class="float-btn" href="https://wa.me/573247615677" target="_blank">
  Reservar ahora
</a>

<script>
const video = document.getElementById("videoTour");

function stopVideo(){
  video.pause();
  video.currentTime = 0;
}
</script>

</body>
</html>
